class Solution {
    public boolean isValid(String s) {
        Stack<Character> stack = new Stack<>();
        for(int i = 0 ; i <s.length();i++) {
            char p = s.charAt(i);
            if(p=='(' || p=='['|| p == '{' ) {
                stack.push(p);
            }

            if(stack.isEmpty()) {
                return false;
            }
            if(p==')'||p==']'|| p=='}') {
                char ch = stack.pop();
                if(ch!='(' && p==')') {
                    return false;
                }
                if(ch!='[' && p==']') {
                    return false;
                }
                if(ch!='{' && p=='}') {
                    return false;
                }


            }
            
        }
    
            
            
            return stack.isEmpty();
        }
       
    }
