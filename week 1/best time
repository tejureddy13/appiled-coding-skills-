class Solution {
    public int maxProfit(int[] prices) {
        int res=0;
        int min=Integer.MAX_VALUE;

        for (int i=0; i<prices.length; i++){
            if (min>prices[i]){
                min=prices[i];
            }

            if (res<prices[i]-min){
                res=prices[i]-min;
            }
        }

        return res;
    }
}
